<!DOCTYPE html>
<html lang="en">
<head>
    <title>Search Properties</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <h1>Search Properties</h1>

    <nav>
        <a href="/dashboard">Dashboard</a> |
        <a href="/saved-properties">Saved Properties</a> |
        <a href="/logout">Logout</a>
    </nav>

    <hr>

    <form action="/search" method="get">
        <label for="city">City:</label>
        <input type="text" id="city" name="city" required>

        <label for="minPrice">Min Price:</label>
        <input type="number" id="minPrice" name="minPrice" min="0" value="0">

        <label for="maxPrice">Max Price:</label>
        <input type="number" id="maxPrice" name="maxPrice" min="0" value="100000000">

        <label for="bedrooms">Bedrooms:</label>
        <input type="number" id="bedrooms" name="bedrooms" min="0" value="0">

        <button type="submit">Search</button>
    </form>

    <hr>

    <h2>Results</h2>

    {{#hasSearch}}
        {{#properties}}
            <div class="property-card">
                <h3>{{streetAddress}}</h3>
                <p>{{city}}, {{state}} {{zipCode}}</p>
                <p>{{bedrooms}} bd | {{bathrooms}} ba | {{squareFeet}} sqft</p>
                <p><strong>${{listPrice}}</strong></p>
                <p>Status: {{listingStatus}}</p>
                <a href="/property/{{propertyId}}">View Details</a>
            </div>
            <hr>
        {{/properties}}

        {{^properties}}
            <p>No properties found.</p>
        {{/properties}}
    {{/hasSearch}}

</body>
</html>
